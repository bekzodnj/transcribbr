/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grammybot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "transcribbr-jobs",
			"database_id": "5422e9d3-422a-406c-851b-377ba9aff7d6",
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "TRANSCRIPTIONS",
				"queue": "transcribbr-transcriptions"
			}
		],
		"consumers": [
			{
				"queue": "transcribbr-transcriptions",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"dead_letter_queue": "transcribbr-transcriptions-dlq",
				"max_concurrency": 2
			},
			{
				"queue": "transcribbr-transcriptions-dlq",
				"max_batch_size": 1,
				"max_retries": 3
			}
		]
	},
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"vars": {
		// TEMPORARY PoC for ALL users: audio goes to Google (free-tier data-use terms apply).
		// Switch to Whisper, using the same recording-language preference: set "false" and redeploy.
		// GEMINI_API_KEY must be a Worker secret, never a plaintext var here.
		"GEMINI_TRANSCRIBE_TEST": "true",
		// Bot-wide UTC-day and UTC-month caps, including inference retries. Zero disables new inference.
		// Audio minutes are estimated from Telegram metadata; unknown duration reserves 10 minutes.
		"GLOBAL_DAILY_AUDIO_MINUTES": "1200",
		"GLOBAL_DAILY_AI_CALLS": "1000",
		"GLOBAL_MONTHLY_AUDIO_MINUTES": "20000",
		"GLOBAL_MONTHLY_AI_CALLS": "20000",
		// Per-user fair-use caps, reset on the 1st (UTC).
		"USER_MONTHLY_AUDIO_MINUTES": "60",
		"USER_MONTHLY_TRANSCRIPTIONS": "100",
		"USER_MONTHLY_TRANSLATIONS": "200",
		"USER_DAILY_TRANSCRIPTIONS": "10",
		// Comma-separated Telegram user IDs that bypass per-user limits. Global caps still apply.
		"ADMIN_USER_IDS": "300163778",
		"BOT_INFO": {
			"id": 8802381338,
			"is_bot": true,
			"first_name": "Transcribe bot",
			"username": "ovozxabarmatnbot",
			"can_join_groups": true,
			"can_read_all_group_messages": false,
			"supports_inline_queries": false,
			"supports_guest_queries": false,
			"can_connect_to_business": false,
			"has_main_web_app": false,
			"has_topics_enabled": false,
			"allows_users_to_create_topics": false,
			"can_manage_bots": false,
			"supports_join_request_queries": false
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
