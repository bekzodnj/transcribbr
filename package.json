{
	"name": "transcribbr",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"dev:bot": "tsx watch --env-file=.env src/dev.ts",
		"start": "wrangler dev",
		"test": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"bot:webhook": "tsx --env-file=.env scripts/set-webhook.ts",
		"db:migrate:local": "wrangler d1 migrations apply transcribbr-jobs --local",
		"db:migrate:remote": "wrangler d1 migrations apply transcribbr-jobs --remote",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@types/node": "^26.4.1",
		"tsx": "^4.23.15",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"grammy": "^1.46.0"
	}
}
